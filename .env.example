# Vorlage für .env — kopieren und ausfüllen:
#
#   cp .env.example .env
#
# .env ist gitignored, diese Vorlage nicht. Keine echten Werte hier eintragen.

# Facebook-Login.
#
# Zwei Funktionen:
#   1. Login für Facebook Marketplace (nur nötig, wenn eine
#      [marketplace.facebook] Sektion in der config.toml steht).
#   2. Login für das Web-UI auf http://localhost:8467.
#
# Punkt 2 gilt immer: das Image bindet das Web-UI an 0.0.0.0 und dort
# startet es ohne Credentials nicht — auch bei einem reinen tutti.ch-Setup,
# das Facebook gar nicht anfasst. Ohne diese Werte läuft die Überwachung
# zwar weiter, aber Port 8467 bleibt tot.
FACEBOOK_USERNAME=
FACEBOOK_PASSWORD=

# Fuer die KI-Bewertung wird hier nichts gebraucht: sie laeuft ueber den
# Ollama-Server im LAN (siehe [ai.ollama] in der config.toml) und Ollama
# kennt keine API-Keys. Nur falls stattdessen ein Cloud-Anbieter in die
# config.toml eingetragen wird, gehoert dessen Key hierher:
# ANTHROPIC_API_KEY=

# Pushbullet-Token für die Benachrichtigungen.
# Holen unter https://www.pushbullet.com/#settings/account
# Leer lassen -> Treffer erscheinen nur im Log und im Web-UI.
PUSHBULLET_TOKEN=
